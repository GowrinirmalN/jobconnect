{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot - JobConnectBackend",
      "request": "launch",
      "mainClass": "com.jobconnect.JobConnectApplication",
      "projectName": "jobconnect-backend",
      "args": "",
      "vmArgs": "-Dspring.profiles.active=dev"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Frontend in Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": ["Spring Boot - JobConnectBackend", "Launch Frontend in Chrome"]
    }
  ]
}

